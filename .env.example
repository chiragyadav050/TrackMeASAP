# ---------------------------------------------------------------------------
# Life OS — environment template
#
# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.
# Every variable below is validated at startup by `src/config/env.server.ts`
# and `src/config/env.client.ts`; a missing or malformed value fails loudly
# with a list of exactly what is wrong.
# ---------------------------------------------------------------------------

# --- Database (server-only secret) -----------------------------------------
# PostgreSQL connection string used by Prisma.
# Local Homebrew/Docker example:
# Migrations only. Required on hosts where DATABASE_URL points at a
# transaction pooler (Supabase port 6543) — a pooler cannot run migrations.
# Leave blank for a plain local Postgres.
DIRECT_URL=""

DATABASE_URL="postgresql://life_os:life_os_dev_password@localhost:5432/life_os?schema=public"

# Separate database for `pnpm test:integration`. Those tests DELETE rows, so
# this must never point at DATABASE_URL — the setup file refuses to run if it
# does, or if the URL does not contain "test".
#   createdb -O life_os life_os_test && pnpm db:test:setup
TEST_DATABASE_URL="postgresql://life_os:life_os_dev_password@localhost:5432/life_os_test?schema=public"

# --- Clerk authentication ---------------------------------------------------
# Get these from https://dashboard.clerk.com → your app → API Keys.
#
# PUBLIC — inlined into the client bundle. Safe to expose.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
#
# SERVER-ONLY SECRET — never expose, never prefix with NEXT_PUBLIC_.
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
#
# Optional. Only needed if you enable the Clerk webhook endpoint at
# /api/webhooks/clerk (Clerk Dashboard → Webhooks → Signing Secret).
# Without it the app still stays in sync via just-in-time profile provisioning.
# CLERK_WEBHOOK_SIGNING_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxx"

# --- Application ------------------------------------------------------------
# Absolute origin of this deployment. Used for absolute URLs and redirects.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Server log verbosity: debug | info | warn | error
LOG_LEVEL="info"

# --- Escape hatch -----------------------------------------------------------
# Set to "1" to skip env validation. Only for container image builds that run
# `next build` without runtime secrets. Never set this in a running app.
# SKIP_ENV_VALIDATION="1"

# Phase 6 — background workers. Optional: without it, reminders simply do
# not fire on a schedule (everything else works).
REDIS_URL="redis://localhost:6379"

# Phase 7 — Telegram bot. Both optional: the bot is an add-on and the web
# app works without it. Get the token from @BotFather; generate the webhook
# secret with `openssl rand -hex 32`. NEVER commit real values.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""

# Phase 8 — Gemini. Optional: with no key the assistant reports itself
# offline rather than inventing answers.
GEMINI_API_KEY=""
